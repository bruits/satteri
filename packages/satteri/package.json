{
  "name": "satteri",
  "version": "0.11.7",
  "description": "High-performance Markdown and MDX processing",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bruits/satteri.git"
  },
  "files": [
    "dist",
    "browser.js",
    "index.js",
    "index.d.ts",
    "webcontainer-fallback.cjs"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#binding": {
      "workerd": "./dist/binding.workerd.js",
      "browser": "./dist/binding.browser.js",
      "default": "./dist/binding.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build:binary:wasm": "napi build --manifest-path ../../crates/satteri-napi-binding/Cargo.toml --output-dir . --platform --release --esm --strip --target wasm32-wasip1",
    "postbuild:binary:wasm": "node patch-binding.js",
    "build:binary:native": "napi build --manifest-path ../../crates/satteri-napi-binding/Cargo.toml --output-dir . --platform --release --esm --strip",
    "postbuild:binary:native": "node patch-binding.js",
    "build:binary:native:lite": "napi build --manifest-path ../../crates/satteri-napi-binding/Cargo.toml --output-dir . --platform --release --esm --strip -- --no-default-features",
    "postbuild:binary:native:lite": "node patch-binding.js",
    "build:binary:native:cross": "napi build --manifest-path ../../crates/satteri-napi-binding/Cargo.toml --output-dir . --platform --release --esm --strip --cross-compile",
    "postbuild:binary:native:cross": "node patch-binding.js",
    "build:binary:native:debug": "napi build --manifest-path ../../crates/satteri-napi-binding/Cargo.toml --output-dir . --platform --esm",
    "postbuild:binary:native:debug": "node patch-binding.js",
    "build:ts": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "build": "pnpm build:ts && pnpm build:binary:native",
    "build:wasm": "pnpm build:ts && pnpm build:binary:wasm",
    "artifacts": "napi create-npm-dirs && napi artifacts",
    "dev": "tsc --watch",
    "vitest": "vitest",
    "test": "vitest run",
    "test:workerd": "node --test test/workerd.test.mjs",
    "bench": "vitest bench --run"
  },
  "dependencies": {
    "@types/estree-jsx": "^1.0.5",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/unist": "^3.0.3"
  },
  "devDependencies": {
    "@codspeed/vitest-plugin": "^5.4.0",
    "@emnapi/core": "2.0.0-beta.3",
    "@emnapi/runtime": "2.0.0-beta.3",
    "@mdx-js/mdx": "^3.1.1",
    "@napi-rs/wasm-runtime": "^1.2.7",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "esbuild": "^0.27.4",
    "fast-check": "^4.7.0",
    "hastscript": "^9.0.1",
    "markdown-it": "^15.0.2",
    "markdown-it-attrs": "^5.0.1",
    "mdast-util-mdx": "^3.0.0",
    "mdast-util-to-hast": "^13.2.1",
    "miniflare": "^4.20260507.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-definition-list": "^2.0.0",
    "remark-directive": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.0.2",
    "unified": "^11.0.5",
    "vitest": "^4"
  },
  "napi": {
    "binaryName": "satteri_napi",
    "packageName": "@bruits/satteri",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "aarch64-linux-android",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "x86_64-unknown-freebsd",
      "wasm32-wasip1"
    ],
    "wasm": {
      "cpu": false,
      "optionalDependency": false,
      "browser": {
        "asyncInit": true
      }
    }
  }
}
