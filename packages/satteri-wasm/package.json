{
  "name": "@bruits/satteri-wasm",
  "version": "0.1.0",
  "description": "WASI-free WebAssembly bindings for Sätteri",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bruits/satteri.git",
    "directory": "packages/satteri-wasm"
  },
  "files": [
    "dist",
    "index.d.ts",
    "index.js",
    "materialize.js",
    "README.md",
    "runtime.d.ts",
    "runtime.js",
    "wasm.d.ts"
  ],
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./runtime": {
      "types": "./runtime.d.ts",
      "import": "./runtime.js",
      "default": "./runtime.js"
    },
    "./satteri.wasm": {
      "types": "./wasm.d.ts",
      "default": "./dist/satteri_wasm_bg.wasm"
    },
    "./runtime.wasm": {
      "types": "./wasm.d.ts",
      "default": "./dist/satteri_runtime_bg.wasm"
    }
  },
  "scripts": {
    "build": "npm run build:ts",
    "build:ts": "wasm-pack build ../../crates/satteri-wasm-binding --target web --release --out-dir ../../packages/satteri-wasm/dist --out-name satteri_wasm --no-pack && wasm-pack build ../../crates/satteri-wasm-binding --target web --release --out-dir ../../packages/satteri-wasm/dist --out-name satteri_runtime --no-pack --no-default-features && node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist/.gitignore', { force: true })\"",
    "test": "npm run build && node --test test/runtime.test.mjs"
  },
  "dependencies": {
    "satteri": "workspace:*"
  }
}
